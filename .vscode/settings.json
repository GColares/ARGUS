{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.py[cod]": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.venv": false
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/*.py[cod]": true,
        "**/.venv": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true
    },
    "github.copilot.chat.agent.isolationMode": "workspace",
    "chat.editing.alwaysUseWorktree": false,
    "git.detectWorktrees": false
}